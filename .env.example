# quant-platform environment variables
# Copy this file to .env and fill in values as needed.

# --- Data directories (optional, defaults to ./data) ---
# QD_DATA_DIR=data
# QD_RAW_DIR=data/raw
# QD_SILVER_DIR=data/silver
# QD_GOLD_DIR=data/gold
# QD_LOG_LEVEL=INFO

# --- Twelve Data (free tier: https://twelvedata.com/pricing) ---
# Register at https://twelvedata.com, get API key from dashboard.
# Free tier: 800 API credits/day, 8 per minute.
# TWELVE_DATA_API_KEY=

# --- Alpha Vantage (free tier: https://www.alphavantage.co/support/#api-key) ---
# Register at https://www.alphavantage.co, claim free API key.
# Free tier: 25 requests/day.
# ALPHA_VANTAGE_API_KEY=

# --- OANDA (practice account: https://www.oanda.com/apply/demo) ---
# Create demo/practice account at OANDA, get API token from account settings.
# OANDA_API_KEY=
# OANDA_ACCOUNT_ID=
# OANDA_ENV=practice
